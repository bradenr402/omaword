# Maintainer: Braden Roth <bradenr402@gmail.com>
pkgname=omaword-git
_pkgname=omaword
pkgver=0.1.0
pkgrel=1
pkgdesc='Keyboard-first offline Bible reader for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/bradenr402/omaword'
license=('MIT' 'CC-BY-4.0')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'fontconfig' 'libpipewire' 'hicolor-icon-theme')
makedepends=('git')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    if git describe --tags --long >/dev/null 2>&1; then
        git describe --tags --long --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
    else
        printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
    fi
}

build() {
    mkdir -p build
    cd build
    qmake6 "$srcdir/$_pkgname/omaword.pro" \
        QMAKE_CFLAGS_RELEASE="$CFLAGS" QMAKE_CXXFLAGS_RELEASE="$CXXFLAGS" QMAKE_LFLAGS_RELEASE="$LDFLAGS"
    make
}

package() {
    cd "$_pkgname"
    install -Dm755 "$srcdir/build/$_pkgname" "$pkgdir/usr/bin/$_pkgname"
    install -Dm644 "$srcdir/build/$_pkgname.desktop" "$pkgdir/usr/share/applications/$_pkgname.desktop"
    install -Dm644 assets/app.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_pkgname.svg"
    install -Dm644 assets/app-symbolic.svg "$pkgdir/usr/share/icons/hicolor/symbolic/apps/$_pkgname-symbolic.svg"
    install -Dm644 assets/omaword.1 "$pkgdir/usr/share/man/man1/$_pkgname.1"
    install -Dm644 assets/completions/omaword.bash "$pkgdir/usr/share/bash-completion/completions/$_pkgname"
    install -Dm644 assets/completions/_omaword "$pkgdir/usr/share/zsh/site-functions/_$_pkgname"
    install -Dm644 assets/completions/omaword.fish "$pkgdir/usr/share/fish/vendor_completions.d/$_pkgname.fish"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
