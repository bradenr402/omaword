#!/usr/bin/env bash
set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
jobs=${JOBS:-$(getconf _NPROCESSORS_ONLN)}
if [[ ! $jobs =~ ^[1-9][0-9]*$ ]]; then
    printf 'JOBS must be a positive integer.\n' >&2
    exit 1
fi

mkdir -p -- "$root/build"
cd -- "$root/build"
qmake6 "$root/omabible.pro"
make -j"$jobs" "$@"
