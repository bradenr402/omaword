#!/usr/bin/env bash
set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source "$root/branding.env"
build_dir=${BUILD_DIR:-$root/build}
build_dir=$(realpath -m -- "$build_dir")
jobs=${JOBS:-$(getconf _NPROCESSORS_ONLN)}
if [[ ! $jobs =~ ^[1-9][0-9]*$ ]]; then
    printf 'JOBS must be a positive integer.\n' >&2
    exit 1
fi

mkdir -p -- "$build_dir"
cd -- "$build_dir"
qmake6 "$root/omabible.pro"
make -j"$jobs" "$@"
# Also refresh the compatibility link when make found the binary up to date.
if [[ -x $build_dir/$BRAND_ID ]]; then
    ln -sfn -- "$BRAND_ID" "$build_dir/$BRAND_STORAGE_ID"
fi
