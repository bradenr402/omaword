#!/usr/bin/env python3
"""Convert OpenBible.info cross references into resources/crossrefs.bin.

Source: https://a.openbible.info/data/cross-references.zip, "Cross
references" by OpenBible.info (https://www.openbible.info/labs/cross-references/),
licensed CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/). The output
is an adaptation of it (converted; rows without positive votes dropped,
duplicates merged), under the same license, not the app's MIT. Run at
development time only; the app never downloads anything. Usage:

    bin/crossrefs [cross-references.zip | cross_references.txt]

Without an argument the ZIP is downloaded to a temporary directory.

OpenBible verse IDs ("Gen.1.1", ranges "Ps.89.11-Ps.89.12") use KJV
versification and OSIS-style book abbreviations. They are mapped to the app's
USFM book codes, then to the stable book IDs of src/biblebooks.cpp (GEN = 1).
Rows with votes <= 0 (disputed or unvoted) are dropped; a pair listed more
than once keeps its highest votes.

Output: a qCompress() payload (4-byte big-endian length + zlib stream) of

    "OWXR" u8 version=1 u32 sources u32 rows          (big-endian)
    sources x (u8 book delta from previous source, u8 chapter, u8 verse)
    sources x varint target count
    rows x u8 book delta  (targets ascend within a source; first is from 0)
    rows x u8 chapter     (book delta 0: chapter delta; else the chapter)
    rows x varint verse   (same book and chapter: verse delta; else the verse)
    rows x u8 span        (end verse - start verse in one chapter; 255: explicit end)
    ends x (u8 book, u8 chapter, u8 verse) for each span 255, in row order
    rows x varint votes

Columns compress far better than records. Decoded by BibleBackend.
"""
import io
import re
import struct
import sys
import tempfile
import urllib.request
import zipfile
import zlib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUTPUT = ROOT / "resources" / "crossrefs.bin"
URL = "https://a.openbible.info/data/cross-references.zip"
# OpenBible abbreviations -> USFM book codes.
OSIS = {
    "Gen": "GEN", "Exod": "EXO", "Lev": "LEV", "Num": "NUM", "Deut": "DEU", "Josh": "JOS",
    "Judg": "JDG", "Ruth": "RUT", "1Sam": "1SA", "2Sam": "2SA", "1Kgs": "1KI", "2Kgs": "2KI",
    "1Chr": "1CH", "2Chr": "2CH", "Ezra": "EZR", "Neh": "NEH", "Esth": "EST", "Job": "JOB",
    "Ps": "PSA", "Prov": "PRO", "Eccl": "ECC", "Song": "SNG", "Isa": "ISA", "Jer": "JER",
    "Lam": "LAM", "Ezek": "EZK", "Dan": "DAN", "Hos": "HOS", "Joel": "JOL", "Amos": "AMO",
    "Obad": "OBA", "Jonah": "JON", "Mic": "MIC", "Nah": "NAM", "Hab": "HAB", "Zeph": "ZEP",
    "Hag": "HAG", "Zech": "ZEC", "Mal": "MAL", "Matt": "MAT", "Mark": "MRK", "Luke": "LUK",
    "John": "JHN", "Acts": "ACT", "Rom": "ROM", "1Cor": "1CO", "2Cor": "2CO", "Gal": "GAL",
    "Eph": "EPH", "Phil": "PHP", "Col": "COL", "1Thess": "1TH", "2Thess": "2TH", "1Tim": "1TI",
    "2Tim": "2TI", "Titus": "TIT", "Phlm": "PHM", "Heb": "HEB", "Jas": "JAS", "1Pet": "1PE",
    "2Pet": "2PE", "1John": "1JN", "2John": "2JN", "3John": "3JN", "Jude": "JUD", "Rev": "REV",
}


def book_ids():
    codes = re.findall(r'\{"([0-9A-Z]{3})","', (ROOT / "src" / "biblebooks.cpp").read_text())
    return {code: index + 1 for index, code in enumerate(codes)}


def source_text(argument):
    if argument and argument.endswith(".txt"):
        return Path(argument).read_text(encoding="utf-8")
    if argument:
        data = Path(argument).read_bytes()
    else:
        with tempfile.TemporaryDirectory() as directory:
            target = Path(directory) / "cross-references.zip"
            urllib.request.urlretrieve(URL, target)
            data = target.read_bytes()
    with zipfile.ZipFile(io.BytesIO(data)) as archive:
        return archive.read("cross_references.txt").decode("utf-8")


def varint(value):
    out = bytearray()
    while True:
        byte = value & 0x7F
        value >>= 7
        if value:
            out.append(byte | 0x80)
        else:
            out.append(byte)
            return out


def main():
    ids = book_ids()
    assert len(ids) == 86 and ids["GEN"] == 1 and ids["REV"] == 66, "unexpected src/biblebooks.cpp"
    mapping = {osis: ids[code] for osis, code in OSIS.items()}

    def verse(text):
        book, chapter, number = text.split(".")
        key = (mapping[book], int(chapter), int(number))
        assert 1 <= key[1] <= 255 and 1 <= key[2] <= 254, text
        return key

    rows, dropped = {}, 0
    for line in source_text(sys.argv[1] if len(sys.argv) > 1 else None).splitlines():
        if not line.strip() or line.startswith("From Verse"):
            continue
        origin, target, votes = line.split("\t")[:3]
        votes = int(votes)
        if votes <= 0:
            dropped += 1
            continue
        parts = target.split("-")
        start = verse(parts[0])
        end = verse(parts[1]) if len(parts) > 1 else start
        key = (verse(origin), start, end)
        rows[key] = max(votes, rows.get(key, 0))
    ordered = sorted(rows.items())

    sources = []
    for (origin, _, _), _ in ordered:
        if not sources or sources[-1][0] != origin:
            sources.append([origin, 0])
        sources[-1][1] += 1
    head, counts = bytearray(), bytearray()
    previous = (0, 0, 0)
    for origin, count in sources:
        head += bytes([origin[0] - previous[0], origin[1], origin[2]])
        counts += varint(count)
        previous = origin
    books, chapters, verses, spans, ends, votes_column = (bytearray() for _ in range(6))
    current, last = None, (0, 0, 0)
    for (origin, start, end), votes in ordered:
        if origin != current:
            current, last = origin, (0, 0, 0)
        if start[0] != last[0]:
            books.append(start[0] - last[0]); chapters.append(start[1]); verses += varint(start[2])
        elif start[1] != last[1]:
            books.append(0); chapters.append(start[1] - last[1]); verses += varint(start[2])
        else:
            books.append(0); chapters.append(0); verses += varint(start[2] - last[2])
        last = start
        if end[:2] == start[:2] and 0 <= end[2] - start[2] < 255:
            spans.append(end[2] - start[2])
        else:
            spans.append(255); ends += bytes(end)
        votes_column += varint(votes)
    payload = b"OWXR" + struct.pack(">BII", 1, len(sources), len(ordered)) + bytes(head + counts + books
        + chapters + verses + spans + ends + votes_column)
    OUTPUT.write_bytes(struct.pack(">I", len(payload)) + zlib.compress(payload, 9))
    print(f"{len(ordered)} cross references from {len(sources)} verses ({dropped} with votes <= 0 dropped); "
          f"{OUTPUT.relative_to(ROOT)}: {OUTPUT.stat().st_size} bytes")


if __name__ == "__main__":
    main()
