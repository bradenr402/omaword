#compdef omaword
# zsh completion for omaword: `omaword completion zsh > ~/.zfunc/_omaword`, with
# fpath+=(~/.zfunc) before compinit in ~/.zshrc.

_omaword_translations() {
    local -a names
    names=(${(f)"$(omaword translations --names 2>/dev/null)"})
    _describe -t translations 'translation' names
}

# A group's commands, its default one first.
_omaword_subcommands() {
    case $1 in
        books) reply=("list:list the translation's books" "outline:print a book's section headings") ;;
        marks) reply=('list:list your marks' 'show:print the marks on a passage' 'export:print your marks as Markdown'
                      'backup:back up your marks as JSON') ;;
        tags) reply=('list:list your tags') ;;
        desk) reply=('show:print the Desk') ;;
        history) reply=('list:list the passages you visited') ;;
        ribbon) reply=('show:print where the ribbon lies') ;;
        translations|versions) reply=('list:list the installed translations' "show:show a translation's source and rights") ;;
        catalog) reply=('list:list the translations AO Lab offers' "show:show a translation in AO Lab's catalog"
                        "refresh:download AO Lab's current catalog") ;;
        *) reply=() ;;
    esac
}

_omaword() {
    local -a commands reply
    commands=(
        'open:open a passage in a window'
        'lookup:look up a passage in a small window'
        'read:print passages as the reader lays them out'
        'quote:print passages as quotations'
        'refs:print cross-references and passages tagged alike'
        'search:search the Bible'
        'link:print an omaword: link to a passage'
        "books:list a translation's books, or a book's outline"
        'marks:list your highlights, notes, and tags'
        'tags:list your tags'
        'desk:print the Desk'
        'history:list the passages you visited'
        'ribbon:print where the ribbon lies'
        'translations:list the installed translations, or show one'
        "catalog:browse AO Lab's catalog of translations"
        'import:install a translation from AO complete JSON'
        'completion:print a shell completion script'
        'help:show help for OmaWord or a command'
    )
    local -a translation
    translation=('(-t --translation)'{-t+,--translation=}'[use a translation (abbreviation or ID)]:translation:_omaword_translations')
    if (( CURRENT == 2 )); then
        _describe -t commands 'command' commands
        _arguments '(- *)'{-h,--help}'[show help]' '(- *)'{-v,--version}'[show the version]'
        return
    fi
    local command=$words[2]
    shift words; (( CURRENT-- ))
    _omaword_subcommands $command
    if (( $#reply )); then
        if (( CURRENT == 2 )) && [[ $words[CURRENT] != -* ]]; then
            _describe -t commands 'command' reply
            return
        fi
        # The group's default command, unless another is named.
        if (( ${reply[(I)$words[2]:*]} )); then
            command+=" $words[2]"; shift words; (( CURRENT-- ))
        else
            command+=" ${reply[1]%%:*}"
        fi
    fi
    case $command in
        open) _arguments $translation '--here[in the window you were reading]' '(- *)'{-h,--help}'[show help]' '*:passage:' ;;
        lookup) _arguments $translation '(- *)'{-h,--help}'[show help]' '*:text:' ;;
        read) _arguments $translation '--footnotes[the footnotes after each passage]' '--json[JSON output]' \
                  '--color=[when to color]:when:(auto always never)' '(- *)'{-h,--help}'[show help]' '*:passage:' ;;
        quote) _arguments $translation '--all[every installed translation]' '--plain[the text alone]' '--json[JSON output]' '(- *)'{-h,--help}'[show help]' '*:passage:' ;;
        refs) _arguments $translation '--quote[each passage in full]' '--limit=[at most this many a section]:count:' '--json[JSON output]' \
                  '--color=[when to color]:when:(auto always never)' '(- *)'{-h,--help}'[show help]' '*:passage:' ;;
        search) _arguments $translation '--all[every installed translation]' '*--in=[only these books: ot, nt, apocrypha, or a book]:part:(ot nt apocrypha)' \
                    '--limit=[at most this many matches]:count:' \
                    '--json[JSON output]' '--color=[when to color]:when:(auto always never)' '(- *)'{-h,--help}'[show help]' '*:words:' ;;
        'books list') _arguments $translation '--json[JSON output]' '(- *)'{-h,--help}'[show help]' ;;
        'books outline') _arguments $translation '--json[JSON output]' '(- *)'{-h,--help}'[show help]' ':book or chapter:' ;;
        'marks list') _arguments '(--all)'$translation '(-t --translation)--all[every installed translation]' '*--tag=[only marks with a tag starting so]:tag:' \
                          '--notes[only marks with a note]' '--highlights[only highlighted marks]' '--json[JSON output]' '(- *)'{-h,--help}'[show help]' '*:words:' ;;
        'marks show') _arguments $translation '--json[JSON output]' '(- *)'{-h,--help}'[show help]' '*:passage:' ;;
        'marks export') _arguments '(-o --output)'{-o+,--output=}'[write them to this file]:file:_files' '(- *)'{-h,--help}'[show help]' ;;
        'marks backup') _arguments '(- *)'{-h,--help}'[show help]' ':file (- prints it):_files' ;;
        'tags list'|'history list'|'ribbon show') _arguments '--json[JSON output]' '(- *)'{-h,--help}'[show help]' ;;
        'desk show') _arguments '(- *)'{-h,--help}'[show help]' ;;
        'translations list'|'versions list') _arguments '--names[abbreviations only]' '--json[JSON output]' '(- *)'{-h,--help}'[show help]' ;;
        'catalog list') _arguments "(--all-languages)--language=[this language's, by its ISO 639-3 code]:code:" \
                            "(--language)--all-languages[every language's]" '--json[JSON output]' '(- *)'{-h,--help}'[show help]' '*:words:' ;;
        'catalog show') _arguments '--json[JSON output]' '(- *)'{-h,--help}'[show help]' ':id:' ;;
        'catalog refresh') _arguments '(- *)'{-h,--help}'[show help]' ;;
        'translations show'|'versions show') _arguments '--json[JSON output]' '(- *)'{-h,--help}'[show help]' ':translation:_omaword_translations' ;;
        link) _arguments $translation '(- *)'{-h,--help}'[show help]' '*:passage:' ;;
        import) _arguments '(- *)'{-h,--help}'[show help]' ':file:_files' ;;
        completion) _arguments ':shell:(bash zsh fish)' ;;
        help) if (( CURRENT == 2 )); then
                  _describe -t commands 'command' commands
              else
                  _omaword_subcommands $words[2]
                  (( $#reply )) && _describe -t commands 'command' reply
              fi ;;
    esac
}

_omaword "$@"
