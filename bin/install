#!/usr/bin/env bash
set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source "$root/branding.env"
build_dir=${BUILD_DIR:-$root/build}
build_dir=$(realpath -m -- "$build_dir")
if [[ ! -x $build_dir/$BRAND_ID || ! -f $build_dir/$BRAND_ID.desktop ]]; then
    printf 'Build %s first: %s/bin/build\n' "$BRAND_NAME" "$root" >&2
    exit 1
fi

data_home=${XDG_DATA_HOME:-$HOME/.local/share}
data_home=$(realpath -m -- "$data_home")
completion_home=${BASH_COMPLETION_USER_DIR:-$data_home/bash-completion}
completion_home=$(realpath -m -- "$completion_home")

# The bash completion and the manual page, named as branding.env names the
# command: the completion as the built binary prints it.
temporary=
generated=$(mktemp -d "${TMPDIR:-/tmp}/$BRAND_ID-install.XXXXXX")
trap 'if [[ -n $temporary ]]; then rm -f -- "$temporary"; fi; rm -rf -- "$generated"' EXIT
"$build_dir/$BRAND_ID" completion bash > "$generated/completion.bash"
sed -e "s/OMAWORD/${BRAND_ID^^}/g; s/OmaWord/$BRAND_NAME/g; s/omaword/$BRAND_ID/g" \
    "$root/assets/omaword.1" > "$generated/$BRAND_ID.1"
# The launcher runs this install by path: Omarchy's PATH puts ~/.local/bin
# after /usr/bin, so a bare name would start a packaged OmaWord there instead.
executable=$HOME/.local/bin/$BRAND_ID
[[ $executable =~ ^[[:alnum:]/._-]+$ ]] || executable="\"$executable\""
while IFS= read -r line; do
    if [[ $line == "Exec=$BRAND_ID" || $line == "Exec=$BRAND_ID "* ]]; then
        line="Exec=$executable${line#"Exec=$BRAND_ID"}"
    fi
    printf '%s\n' "$line"
done < "$build_dir/$BRAND_ID.desktop" > "$generated/$BRAND_ID.desktop"

sources=("$build_dir/$BRAND_ID" "$generated/$BRAND_ID.desktop"
    "$root/assets/app.svg" "$root/assets/app-symbolic.svg"
    "$generated/completion.bash" "$generated/$BRAND_ID.1")
destinations=("$HOME/.local/bin/$BRAND_ID" "$data_home/applications/$BRAND_ID.desktop"
    "$data_home/icons/hicolor/scalable/apps/$BRAND_ID.svg"
    "$data_home/icons/hicolor/symbolic/apps/$BRAND_ID-symbolic.svg"
    "$completion_home/completions/$BRAND_ID" "$data_home/man/man1/$BRAND_ID.1")
backup_names=("bin/$BRAND_ID" "applications/$BRAND_ID.desktop"
    "icons/scalable/$BRAND_ID.svg" "icons/symbolic/$BRAND_ID-symbolic.svg"
    "bash-completion/$BRAND_ID" "man/$BRAND_ID.1")
modes=(755 644 644 644 644 644)

# Check every input and destination before backing up or installing anything.
for source_file in "${sources[@]}"; do
    if [[ ! -f $source_file || ! -r $source_file ]]; then
        printf 'Missing or unreadable installation source: %s\n' "$source_file" >&2
        exit 1
    fi
done
preflight_destination() {
    local destination=$1 parent
    if [[ -e $destination && ! -f $destination && ! -L $destination ]]; then
        printf 'Installation destination is not a file: %s\n' "$destination" >&2
        exit 1
    fi
    parent=$(dirname -- "$destination")
    while [[ ! -e $parent && ! -L $parent ]]; do parent=$(dirname -- "$parent"); done
    if [[ ! -d $parent || ! -w $parent || ! -x $parent ]]; then
        printf 'Installation parent is not a writable directory: %s\n' "$parent" >&2
        exit 1
    fi
}
for destination in "${destinations[@]}"; do
    preflight_destination "$destination"
done
# One previous installation is kept, in the state directory: never beside the
# user's library and notes.
state_home=${XDG_STATE_HOME:-$HOME/.local/state}
state_home=$(realpath -m -- "$state_home")
backup_root="$state_home/$BRAND_ID"
preflight_destination "$backup_root/.preflight"

changed=()
for i in "${!destinations[@]}"; do
    destination=${destinations[i]}
    if [[ -f $destination && ! -L $destination ]] &&
        cmp -s -- "${sources[i]}" "$destination" &&
        [[ $(stat -c '%a' -- "$destination") == "${modes[i]}" ]]; then
        continue
    fi
    changed+=("$i")
done

# Preserve every replaced entry, including custom wrappers and dangling symlinks.
# Complete all backups before modifying any installed file.
backup_dir=
backup_existing() {
    local destination=$1 name=$2
    [[ -e $destination || -L $destination ]] || return 0
    if [[ -z $backup_dir ]]; then
        mkdir -p -- "$backup_root"
        backup_dir=$(mktemp -d "$backup_root/.previous-install.XXXXXX")
    fi
    mkdir -p -- "$(dirname -- "$backup_dir/$name")"
    cp -a -- "$destination" "$backup_dir/$name"
}
for i in "${changed[@]}"; do
    backup_existing "${destinations[i]}" "${backup_names[i]}"
done
if [[ -n $backup_dir ]]; then
    rm -rf -- "$backup_root/previous-install"
    mv -T -- "$backup_dir" "$backup_root/previous-install"
    printf 'Kept the replaced installation files in %s\n' "$backup_root/previous-install"
fi

# Same-directory rename replaces files and symlinks without following them and
# allows an already-running executable to keep using its original inode.
for i in "${changed[@]}"; do
    destination=${destinations[i]}
    parent=$(dirname -- "$destination")
    mkdir -p -- "$parent"
    temporary=$(mktemp "$parent/.install-$BRAND_ID.XXXXXX")
    install -m "${modes[i]}" -- "${sources[i]}" "$temporary"
    mv -fT -- "$temporary" "$destination"
    temporary=
done
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$data_home/applications"
fi
if [[ -f $data_home/icons/hicolor/index.theme ]] && command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f "$data_home/icons/hicolor"
fi
printf 'Installed %s to %s\n' "$BRAND_NAME" "${destinations[0]}"
on_path=$(command -v -- "$BRAND_ID" || true)
if [[ -z $on_path ]]; then
    printf 'Add %s to PATH to run %s in a terminal; the launcher runs it by path.\n' "${destinations[0]%/*}" "$BRAND_ID"
elif [[ ! $on_path -ef ${destinations[0]} ]]; then
    printf '%s in a terminal runs %s, earlier on PATH: remove it to run this install there. The launcher runs this one.\n' "$BRAND_ID" "$on_path"
fi
if [[ -d $data_home/$BRAND_ID/install-backups ]]; then
    printf 'Older installs kept backups in %s; nothing uses them now, so you can delete it.\n' "$data_home/$BRAND_ID/install-backups"
fi
# A running OmaWord keeps the build it started with, and every launch opens
# its window in that process: say so, or the new build looks missing.
for pid in $(pgrep -x -- "$BRAND_ID" 2>/dev/null); do
    running=$(readlink -- "/proc/$pid/exe" 2>/dev/null) || continue
    if [[ $running == "${destinations[0]} (deleted)" ]]; then
        printf '%s is still running the previous build (PID %s): close every %s window to run this one.\n' "$BRAND_NAME" "$pid" "$BRAND_NAME"
    elif [[ $running != "${destinations[0]}" ]]; then
        printf '%s is running from %s (PID %s), and launches open in it: close every %s window to run this install.\n' "$BRAND_NAME" "$running" "$pid" "$BRAND_NAME"
    fi
done
