# Local-checkout package: run makepkg from this directory inside the source tree.
pkgname=omabible
pkgver=0.1.0
pkgrel=1
pkgdesc='Offline NET Bible reader with local bookmarks, highlights, and Markdown notes'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'libarchive' 'fontconfig')
makedepends=('gcc' 'make' 'pkgconf')
optdepends=('qt6-wayland: native Wayland support')
# Sources are the enclosing checkout, including uncommitted changes. No remote
# archive or pre-generated tarball is needed; this recipe is not standalone.
source=()
sha256sums=()

build() {
    local root
    root=$(realpath "$startdir/..")
    [[ -f "$root/omabible.pro" ]] || return 1
    mkdir -p "$srcdir/build"
    cd "$srcdir/build"
    qmake6 "$root/omabible.pro" CONFIG+=release
    make
}

package() {
    local root
    root=$(realpath "$startdir/..")
    install -Dm755 "$srcdir/build/omabible" "$pkgdir/usr/bin/omabible"
    install -Dm644 "$root/assets/omabible.desktop" "$pkgdir/usr/share/applications/omabible.desktop"
    install -Dm644 "$root/assets/omabible.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omabible.svg"
    install -Dm644 "$root/assets/omabible-symbolic.svg" "$pkgdir/usr/share/icons/hicolor/symbolic/apps/omabible-symbolic.svg"
    install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
