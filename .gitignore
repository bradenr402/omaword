# Out-of-tree builds and accidental qmake output
/build/
/Makefile*
/.qmake.stash
/.qmake.cache
*.o
moc_*.cpp
qrc_*.cpp

# Arch packaging output (packaging/src is makepkg's work directory,
# packaging/omaword its clone of the source)
/packaging/src/
/packaging/pkg/
/packaging/omaword/
*.pkg.tar.*
*.src.tar.*
*.log

# User-provided Bible content and local data
*_usfm.zip
*.usfm
*.sfm
*.sqlite*
*.db
*.db-*
/data/
/user-data/
/backups/
omaword-notes.md
*backup*.json
