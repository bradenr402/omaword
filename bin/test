#!/usr/bin/env bash
set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
usage() {
    printf 'Usage: bin/test [--suite backend|ui|search|searchui|deskui|historyui|studyui|a11yui|marginsui|motion|contextmenu|searchrender|tags|tagsui|ranges|sound|desktop|importer|catalog|annotations|instance|windows|cli|all] [Qt test arguments]\n'
    printf 'Repeat --suite to select multiple suites; Qt arguments require one suite.\n'
    printf 'JOBS caps total build jobs; TEST_JOBS caps concurrent suites (default 2).\n'
}
suites=()
while (( $# )); do
    case $1 in
        --suite)
            if (( $# < 2 )); then usage >&2; exit 1; fi
            suites+=("$2")
            shift 2
            ;;
        --help|-h) usage; exit 0 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
(( ${#suites[@]} )) || suites=(all)
available=(backend ui search searchui deskui historyui studyui a11yui marginsui motion contextmenu searchrender tags tagsui ranges sound desktop importer catalog annotations instance cli)
[[ ! -f $root/tests/windows.pro ]] || available+=(windows)
selected=()
declare -A seen=()
for suite in "${suites[@]}"; do
    case $suite in
        all) expanded=("${available[@]}") ;;
        backend|ui|search|searchui|deskui|historyui|studyui|a11yui|marginsui|motion|contextmenu|searchrender|tags|tagsui|ranges|sound|desktop|importer|catalog|annotations|instance|windows|cli) expanded=("$suite") ;;
        *) printf 'Unknown suite: %s\n' "$suite" >&2; usage >&2; exit 1 ;;
    esac
    for name in "${expanded[@]}"; do
        if [[ ! ${seen[$name]:-} ]]; then selected+=("$name"); seen[$name]=1; fi
    done
done
if (( $# && ${#selected[@]} != 1 )); then
    printf 'Qt test arguments require a single --suite target.\n' >&2
    exit 1
fi
declare -A projects=([backend]=backend [ui]=ui [importer]=usfm [catalog]=catalog
    [annotations]=blockannotations [instance]=singleinstance [windows]=windows [tags]=tags [tagsui]=tagsui [ranges]=ranges [sound]=sound [desktop]=desktop [search]=search [searchui]=searchui [deskui]=deskui [historyui]=historyui [studyui]=studyui [a11yui]=a11yui [marginsui]=marginsui [motion]=motion [contextmenu]=contextmenu [searchrender]=searchrender [cli]=cli)
declare -A directories=([backend]=tests [ui]=ui-tests [importer]=usfm-tests [catalog]=catalog-tests
    [annotations]=blockannotations [instance]=singleinstance-tests [windows]=windows-tests [tags]=tags-tests [tagsui]=tagsui-tests [ranges]=ranges-tests [sound]=sound-tests [desktop]=desktop-tests [search]=search-tests [searchui]=searchui-tests [deskui]=deskui-tests [historyui]=historyui-tests [studyui]=studyui-tests [a11yui]=a11yui-tests [marginsui]=marginsui-tests [motion]=motion-tests [contextmenu]=contextmenu-tests [searchrender]=searchrender-tests [cli]=cli-tests)
for suite in "${selected[@]}"; do
    if [[ ! -f $root/tests/${projects[$suite]}.pro ]]; then
        printf 'Suite project is unavailable: %s\n' "$root/tests/${projects[$suite]}.pro" >&2
        exit 1
    fi
done
jobs=${JOBS:-$(getconf _NPROCESSORS_ONLN)}
test_jobs=${TEST_JOBS:-2}
for value in "$jobs" "$test_jobs"; do
    if [[ ! $value =~ ^[1-9][0-9]*$ ]]; then
        printf 'JOBS and TEST_JOBS must be positive integers.\n' >&2
        exit 1
    fi
done
(( test_jobs <= jobs )) || test_jobs=$jobs
(( test_jobs <= ${#selected[@]} )) || test_jobs=${#selected[@]}
build_jobs=$((jobs / test_jobs))
build_dir=$(realpath -m -- "${BUILD_DIR:-$root/build}")
log_dir="$build_dir/test-logs"

# Normalize caller-relative fixture paths before any worker changes directory.
if [[ -n ${OMAWORD_TEST_AO_DIR:-} ]]; then
    if [[ ! -d $OMAWORD_TEST_AO_DIR || ! -r $OMAWORD_TEST_AO_DIR || ! -x $OMAWORD_TEST_AO_DIR ]]; then
        printf 'OMAWORD_TEST_AO_DIR must name a readable directory.\n' >&2
        exit 1
    fi
    export OMAWORD_TEST_AO_DIR="$(realpath -- "$OMAWORD_TEST_AO_DIR")"
fi
for variable in OMAWORD_TEST_KJV_JSON OMAWORD_TEST_AO_MIGRATION_SCRIPT; do
    if [[ -n ${!variable:-} ]]; then
        if [[ ! -f ${!variable} || ! -r ${!variable} ]]; then
            printf '%s must name a readable file.\n' "$variable" >&2
            exit 1
        fi
        printf -v "$variable" '%s' "$(realpath -- "${!variable}")"
        export "$variable"
    fi
done
mkdir -p -- "$log_dir"
real_home=$(realpath -m -- "${HOME:-/nonexistent}")
run_suite() {
    local suite=$1
    shift
    mkdir -p -- "$build_dir/${directories[$suite]}"
    cd -- "$build_dir/${directories[$suite]}"
    qmake6 "$root/tests/${projects[$suite]}.pro"
    make -j"$build_jobs"
    # Tests never see the user's real HOME or XDG directories (live theme, data).
    local sandbox="$build_dir/test-home/$suite" name
    rm -rf -- "$sandbox"
    for name in HOME XDG_DATA_HOME XDG_CONFIG_HOME XDG_CACHE_HOME XDG_STATE_HOME XDG_RUNTIME_DIR; do
        mkdir -p -m 700 -- "$sandbox/$name"
        export "$name=$sandbox/$name"
    done
    case $XDG_STATE_HOME/ in
        "$real_home"/.local/*|"$real_home"/.config/*|"$real_home"/.cache/*)
            printf 'Refusing to run %s: XDG_STATE_HOME reaches the real user state.\n' "$suite" >&2; return 1 ;;
    esac
    unset QT_QPA_PLATFORMTHEME
    OMAWORD_SOUND=0 QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software "./tst_${projects[$suite]}" "$@"
}

# Each worker gets a process group so interruption also stops its compiler/test.
set -m
declare -A active=() started=()
cleanup() {
    local pid
    for pid in "${!active[@]}"; do kill -TERM -- "-$pid" 2>/dev/null || true; done
    for pid in "${!active[@]}"; do wait "$pid" 2>/dev/null || true; done
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# Every suite links the core and QML libraries (src/core.pri, qml/qml.pri):
# build them once, with every job, before any suite starts.
printf '[libraries] BUILD (jobs=%s; log=%s/libraries.log)\n' "$jobs" "$log_dir"
(cd -- "$build_dir" && qmake6 "$root/omaword.pro" && make -j"$jobs" sub-src sub-qml) >"$log_dir/libraries.log" 2>&1 &
pid=$!
active[$pid]=libraries
status=0
wait "$pid" || status=$?
unset 'active[$pid]'
if (( status != 0 )); then
    printf '[libraries] FAIL (exit=%s) — %s/libraries.log\n' "$status" "$log_dir" >&2
    while IFS= read -r line || [[ -n $line ]]; do printf '  %s\n' "$line" >&2; done <"$log_dir/libraries.log"
    exit 1
fi
next=0
result=0
while (( next < ${#selected[@]} || ${#active[@]} )); do
    while (( next < ${#selected[@]} && ${#active[@]} < test_jobs )); do
        suite=${selected[next]}
        printf '[%s] START (build jobs=%s; log=%s/%s.log)\n' "$suite" "$build_jobs" "$log_dir" "$suite"
        run_suite "$suite" "$@" >"$log_dir/$suite.log" 2>&1 &
        pid=$!
        active[$pid]=$suite
        started[$pid]=$SECONDS
        next=$((next + 1))
    done
    # Reap any finished worker, including workers that exited between launches.
    # Unlike wait -n, wait PID retains the status of an already-finished job.
    finished=
    for pid in "${!active[@]}"; do
        if ! kill -0 "$pid" 2>/dev/null; then finished=$pid; break; fi
    done
    if [[ -z $finished ]]; then sleep 0.05; continue; fi
    status=0
    wait "$finished" || status=$?
    suite=${active[$finished]}
    elapsed=$((SECONDS - started[$finished]))
    unset 'active[$finished]' 'started[$finished]'
    if (( status == 0 )); then
        printf '[%s] PASS (%ss)\n' "$suite" "$elapsed"
    else
        printf '[%s] FAIL (exit=%s, %ss) — %s/%s.log\n' "$suite" "$status" "$elapsed" "$log_dir" "$suite" >&2
        while IFS= read -r line || [[ -n $line ]]; do printf '  %s\n' "$line" >&2; done <"$log_dir/$suite.log"
        (( result != 0 )) || result=$status
    fi
done
exit "$result"
