#!/usr/bin/env bash
set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source "$root/branding.env"
build_dir=${BUILD_DIR:-$root/build}
build_dir=$(realpath -m -- "$build_dir")
jobs=${JOBS:-$(getconf _NPROCESSORS_ONLN)}
if [[ ! $jobs =~ ^[1-9][0-9]*$ ]]; then
    printf 'JOBS must be a positive integer.\n' >&2
    exit 1
fi

mkdir -p -- "$build_dir"
cd -- "$build_dir"
qmake6 "$root/omaword.pro"
make -j"$jobs" "$@"
# Retire only the exact compatibility alias created by previous builds.
if [[ -L $build_dir/omabible && $(readlink -- "$build_dir/omabible") == "$BRAND_ID" ]]; then
    rm -- "$build_dir/omabible"
fi
