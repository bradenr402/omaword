#!/usr/bin/env python3
"""Update the bundled metadata-only AO catalog (never downloads Bible text)."""
import json
from pathlib import Path
import urllib.request

with urllib.request.urlopen("https://bible.helloao.org/api/available_translations.json", timeout=30) as response:
    data = response.read(8 * 1024 * 1024 + 1)
if len(data) > 8 * 1024 * 1024:
    raise SystemExit("AO catalog exceeds 8 MiB")
catalog = json.loads(data)
if not isinstance(catalog.get("translations"), list) or not catalog["translations"]:
    raise SystemExit("Invalid AO catalog")
destination = Path(__file__).resolve().parent.parent / "resources" / "catalog.json"
destination.write_text(json.dumps(catalog, ensure_ascii=False, separators=(",", ":")) + "\n")
print(f"Bundled metadata for {len(catalog['translations'])} AO editions")
